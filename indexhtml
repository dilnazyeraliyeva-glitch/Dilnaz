<<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Dilnaz Yeraliyeva — Geography student & customer service professional</title>
<style>
:root{
  --bg:#EEF3F2; --surface:#E1EBE9; --ink:#12302F; --muted:#4B6665; --line:#B9CCC9; --accent:#1F7A8C; --gold:#B7791F;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0E1F1F;--surface:#152B2B;--ink:#E4EFEC;--muted:#9DB6B2;--line:#2B4745;--accent:#6CC3D5;--gold:#E3B15C;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0E1F1F;--surface:#152B2B;--ink:#E4EFEC;--muted:#9DB6B2;--line:#2B4745;--accent:#6CC3D5;--gold:#E3B15C;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.65 "Source Sans 3","Segoe UI",system-ui,sans-serif}
h1,h2,h3{font-family:"Fraunces",Georgia,"Times New Roman",serif;font-weight:600;line-height:1.15;margin:0}
a{color:var(--accent)}
a:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.wrap{max-width:760px;margin:0 auto;padding:0 22px}
header.hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line);padding:72px 0 56px}
.contours{position:absolute;inset:0;width:100%;height:100%;stroke:var(--accent);fill:none;opacity:.28}
.hero .wrap{position:relative}
.coords{color:var(--muted);font-size:15px;margin:0 0 18px}
h1{font-size:clamp(46px,12vw,84px);letter-spacing:-.02em}
.tag{font-size:clamp(19px,4vw,23px);color:var(--muted);max-width:30em;margin:20px 0 28px}
.btns{display:flex;flex-wrap:wrap;gap:12px}
.btn{display:inline-block;padding:11px 20px;border-radius:999px;border:1.5px solid var(--ink);color:var(--ink);text-decoration:none;font-weight:600}
.btn.fill{background:var(--ink);color:var(--bg)}
.btn:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
section{padding:52px 0;border-bottom:1px solid var(--line)}
h2{font-size:30px;margin-bottom:24px}
.about p{margin:0 0 14px;max-width:38em}
.timeline{list-style:none;margin:0;padding:0 0 0 22px;border-left:2px solid var(--line)}
.timeline li{position:relative;padding:0 0 34px 8px}
.timeline li:last-child{padding-bottom:0}
.timeline li::before{content:"";position:absolute;left:-31px;top:9px;width:12px;height:12px;border-radius:50%;background:var(--accent);border:3px solid var(--bg)}
.when{color:var(--gold);font-weight:600;font-size:15px;margin:0}
h3{font-size:22px;margin:2px 0 2px}
.where{color:var(--muted);margin:0 0 10px}
.timeline ul{margin:0;padding-left:18px}
.timeline li li{padding:0;margin:3px 0}
.timeline li li::before{display:none}
.edu{background:var(--surface);padding:22px;border-radius:14px}
.edu p{margin:4px 0}
.chips{display:flex;flex-wrap:wrap;gap:10px;list-style:none;margin:0;padding:0}
.chips li{padding:7px 15px;border:1.5px solid var(--line);border-radius:999px;background:var(--surface)}
.langs{display:grid;gap:14px}
.lang{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);padding-bottom:10px}
.lang span:last-child{color:var(--muted)}
footer{padding:44px 0 56px}
footer p{margin:6px 0}
.lang-btn{position:absolute;top:18px;right:22px;z-index:2;display:flex;border:1.5px solid var(--ink);border-radius:999px;overflow:hidden}
.lang-btn button{font:600 14px inherit;font-family:inherit;border:0;background:transparent;color:var(--ink);padding:7px 14px;cursor:pointer}
.lang-btn button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.lang-btn button:focus-visible{outline:3px solid var(--gold);outline-offset:-3px}
.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.gallery figure{margin:0;aspect-ratio:1/1;border-radius:14px;background:var(--surface);border:1px solid var(--line);position:relative;overflow:hidden;display:flex;align-items:flex-end}
.gallery img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.gallery figcaption{position:relative;width:100%;padding:28px 14px 10px;font-weight:600;font-size:15px;line-height:1.3;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.72))}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<header class="hero">
  <div class="lang-btn" role="group" aria-label="Language"><button id="bEn" aria-pressed="true">EN</button><button id="bRu" aria-pressed="false">RU</button></div>
  <svg class="contours" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g stroke-width="1.2">
      <path d="M480 60c90-30 220 10 270 90s20 170-60 220-190 50-270 10-120-120-80-190 70-100 140-130z"/>
      <path d="M500 100c70-20 170 10 210 75s10 135-50 175-150 40-210 5-95-95-62-150 60-80 112-105z"/>
      <path d="M525 140c50-12 120 8 150 55s5 100-38 128-110 28-152 2-68-70-45-110 45-58 85-75z"/>
      <path d="M550 180c30-6 75 8 92 38s0 62-26 78-70 16-96 0-40-42-26-66 26-36 56-50z"/>
      <path d="M575 218c16-2 40 6 46 22s-6 34-22 40-40 6-52-6-14-26-4-38 18-14 32-18z"/>
      <path d="M-40 400c90-40 170-10 230 40s140 80 220 60"/>
      <path d="M-40 440c80-30 150-5 205 40s120 62 190 50"/>
    </g>
  </svg>
  <div class="wrap">
    <p class="coords" data-ru="Астана, Казахстан · 51.17° с. ш., 71.45° в. д.">Astana, Kazakhstan · 51.17° N, 71.45° E</p>
    <h1>Dilnaz Yeraliyeva</h1>
    <p class="tag" data-ru="Студентка-географ Евразийского национального университета им. Л.Н. Гумилёва. Работала с клиентами и студентами в Казахстане и США.">Geography student at L.N. Gumilyov Eurasian National University, with hands-on experience serving customers in Kazakhstan and the USA.</p>
    <div class="btns">
      <a class="btn fill" href="mailto:dilnazyeraliyeva@gmail.com" data-ru="Написать мне">Email me</a>
      <a class="btn" href="#experience" data-ru="Мой опыт">See my experience</a>
    </div>
  </div>
</header>

<main class="wrap">
  <section class="about" id="about">
    <h2 data-ru="Обо мне">About me</h2>
    <p data-ru="Я студентка третьего курса в Астане, учусь на научного географа. Параллельно с учёбой работала в рознице и сфере сервиса, летом 2025 года была в США по программе Work and Travel, а в 2025–2026 годах координировала студентов J-1.">I'm a third-year geography student in Astana, training as a scientific geographer. Alongside my studies I've worked in retail and customer service, spent the summer of 2025 in the USA on the Work and Travel program, and coordinated J-1 students in 2025–2026.</p>
    <p data-ru="Мне нравится помогать людям, быстро учиться и работать в команде. Люблю спорт и бег, участвую в забегах, интересуюсь саморазвитием и путешествиями.">I like helping people find what they need, learning quickly and working well in a team. I love sport and running, including races, and I'm into self-development and travel.</p>
  </section>

  <section id="education">
    <h2 data-ru="Образование">Education</h2>
    <div class="edu">
      <h3 data-ru="Бакалавриат, научный географ">Bachelor's degree, Scientific Geographer</h3>
      <p data-ru="Евразийский национальный университет, Астана">Eurasian National University, Astana</p>
      <p class="where" data-ru="2023 – настоящее время · выпуск в 2027">2023 – present · expected graduation 2027</p>
    </div>
  </section>

  <section id="experience">
    <h2 data-ru="Опыт работы">Experience</h2>
    <ol class="timeline">
      <li>
        <p class="when" data-ru="2025–2026">2025–2026</p>
        <h3 data-ru="Координатор студентов J-1">J-1 Students Coordinator</h3>
        <p class="where" data-ru="Work and Travel">Work and Travel</p>
        <ul>
          <li data-ru="14 студентов успешно уехали на программу при моём сопровождении">14 students departed on the program with my support</li>
          <li data-ru="Сопровождала студентов в течение всей программы, на связи на каждом этапе">Supported students throughout the whole program, from application to return</li>
          <li data-ru="Помогала подбирать подходящий оффер под цели и уровень английского студента">Helped students choose the right job offer for their goals and English level</li>
          <li data-ru="Проводила морально-психологическую подготовку к жизни и работе в другой стране">Prepared students mentally and emotionally for living and working abroad</li>
          <li data-ru="Отвечала на вопросы и помогала решать сложные ситуации во время программы">Answered questions and helped solve problems during the program</li>
        </ul>
      </li>
      <li>
        <p class="when" data-ru="Лето 2025">Summer 2025</p>
        <h3 data-ru="Участница программы Work and Travel">Work and Travel Participant</h3>
        <p class="where" data-ru="США">United States</p>
        <ul>
          <li data-ru="Работала в международной команде и ежедневно говорила с клиентами по-английски">Worked in an international team and spoke English with customers every day</li>
          <li data-ru="Получила опыт клиентского сервиса в динамичной среде">Gained customer service experience in a fast-paced setting</li>
          <li data-ru="Повысила уровень английского и навыки межкультурной коммуникации">Improved my English and intercultural communication</li>
          <li data-ru="Научилась управлять временем в напряжённом графике">Learned to manage my time under pressure</li>
        </ul>
      </li>
      <li>
        <p class="when">2023</p>
        <h3 data-ru="Продавец-консультант, Adidas">Sales Consultant, Adidas</h3>
        <p class="where" data-ru="Астана">Astana</p>
        <ul>
          <li data-ru="Консультировала клиентов и подбирала товары под их потребности">Advised customers and matched products to their needs</li>
          <li data-ru="Работала на кассе и в программе 1С">Ran the cash register and worked in the 1C system</li>
          <li data-ru="Участвовала в приёме и выкладке товара">Helped receive and display new stock</li>
          <li data-ru="Поддерживала высокий уровень сервиса и командную работу">Kept service quality high and supported my team</li>
        </ul>
      </li>
    </ol>
  </section>

  <section id="gallery">
    <h2 data-ru="Галерея">Gallery</h2>
    <div class="gallery">
      <figure><img src="usa.jpg" alt="Dilnaz sitting on the lawn in Central Park, New York, facing the skyline" style="object-position:50% 50%" loading="lazy"><figcaption data-ru="Central Park, Нью-Йорк">Central Park, New York</figcaption></figure>
      <figure><img src="students.jpg" alt="Group photo with J-1 program students in Astana" style="object-position:50% 50%" loading="lazy"><figcaption data-ru="Студенты J-1, которых я сопровождала">J-1 students I coordinated</figcaption></figure>
      <figure><img src="adidas.jpg" alt="Adidas store team sitting on a bench" style="object-position:50% 40%" loading="lazy"><figcaption data-ru="Моя команда в Adidas">My team at Adidas</figcaption></figure>
      <figure><img src="running.jpg" alt="Dilnaz with a finisher medal at the Astana half marathon" style="object-position:50% 62%" loading="lazy"><figcaption data-ru="Бег: забег в Астане">Running: race day in Astana</figcaption></figure>
    </div>
  </section>

  <section id="skills">
    <h2 data-ru="Навыки">Skills</h2>
    <ul class="chips">
      <li data-ru="Клиентоориентированность">Customer focus</li><li data-ru="Коммуникабельность">Communication</li><li data-ru="Работа с возражениями">Handling objections</li><li data-ru="Работа в команде">Teamwork</li>
      <li data-ru="Эффективное использование ресурсов">Resource efficiency</li><li data-ru="Тайм-менеджмент">Time management</li><li data-ru="Быстрая обучаемость">Quick learner</li>
    </ul>
  </section>

  <section id="languages">
    <h2 data-ru="Языки">Languages</h2>
    <div class="langs">
      <div class="lang"><span data-ru="Казахский">Kazakh</span><span data-ru="Родной">Native</span></div>
      <div class="lang"><span data-ru="Русский">Russian</span><span data-ru="Свободно">Fluent</span></div>
      <div class="lang"><span>English</span><span data-ru="B1 · средний">B1 · Intermediate</span></div>
    </div>
  </section>
</main>

<footer class="wrap" id="contact">
  <h2 data-ru="Контакты">Contact</h2>
  <p><span data-ru="Почта:">Email:</span> <a href="mailto:dilnazyeraliyeva@gmail.com">dilnazyeraliyeva@gmail.com</a></p>
  <p data-ru="Живу в Астане, Казахстан">Based in Astana, Kazakhstan</p>
</footer>
<script>
const els=[...document.querySelectorAll("[data-ru]")];
els.forEach(e=>e.dataset.en=e.innerHTML);
function setLang(l){
  els.forEach(e=>e.innerHTML=l==="ru"?e.dataset.ru:e.dataset.en);
  document.documentElement.lang=l;
  bEn.setAttribute("aria-pressed",l==="en");bRu.setAttribute("aria-pressed",l==="ru");
}
bEn.onclick=()=>setLang("en");bRu.onclick=()=>setLang("ru");
</script>
</body>
</html>
